        $FavorEscrow$_contract_store(($self'arbitrator, $self'customer, $self'freelancer, $self'dealId, $self'deadlineDurationSeconds, $self'amount, $self'status, $self'deadlineAt));
        return ();
    }
    ;; Receive "refund" message
    if (text_op == 0x2282abf8277dc4ff9183255e3d0fb487fa3963bcea406ca8943205a96e5346cd) {
