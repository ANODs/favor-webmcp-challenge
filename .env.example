DATABASE_URL=postgresql://favor:favor@localhost:5432/favor?schema=public
BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
ABUSE_IP_HASH_SECRET=replace-with-a-different-long-random-secret

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Premium contract auto-translation via a GLM-compatible API.
GLM_API_KEY=
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TRANSLATION_MODEL=glm-4-flash

TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=FavorDealsBot
TELEGRAM_SUPPORT_CHAT_ID=
# Optional proxy. Leave empty or set to "direct" when the host can reach api.telegram.org.
TELEGRAM_PROXY_URL=direct
TELEGRAM_BOT_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_BOT_RETRY_DELAY_MS=3000
MODERATOR_TELEGRAM_IDS=
AUTH_COOKIE_NAME=favor_session

# Unified pricing source. GRAM, FAVOR and Telegram Stars amounts are derived from USDT.
SUBSCRIPTION_MONTHLY_PRICE_USDT=10
SUBSCRIPTION_YEARLY_DISCOUNT_PERCENT=20
SUBSCRIPTION_FAVOR_DISCOUNT_PERCENT=10
TELEGRAM_STARS_PER_USDT=50
# Legacy fallback used only when TELEGRAM_STARS_PER_USDT is absent.
SUBSCRIPTION_PRICE_STARS=500
AUCTION_START_PRICE_USDT=10
AUCTION_MAX_START_FAVOR=100000

CRON_SECRET=replace-with-a-long-random-secret
GRAM_USDT_FALLBACK_PRICE=0
TON_RECIPIENT_WALLET=
TONCENTER_API_KEY=
TONCENTER_API_BASE_URL=https://toncenter.com/api/v3
TONAPI_BASE_URL=https://tonapi.io
FAVOR_JETTON_MASTER_ADDRESS=
FAVOR_ORACLE_MIN_PRICE_GRAM=0.000001
FAVOR_ORACLE_MAX_PRICE_GRAM=1000000
FAVOR_ORACLE_FALLBACK_PRICE_GRAM=1
USDT_JETTON_MASTER_ADDRESS=
USDT_JETTON_DECIMALS=6
STABLECOIN_ESCROW_DEPLOY_TON=0.05
STABLECOIN_JETTON_TRANSFER_TON=0.1
STABLECOIN_JETTON_FORWARD_TON=0.01

# Development-only session authentication. Never enable this in production.
NEXT_PUBLIC_ENABLE_DEV_SESSION_AUTH=false
DEV_SESSION_TELEGRAM_ID=
DEV_SESSION_ROLE=user
DEV_SESSION_NAME=Local Developer
DEV_SESSION_USERNAME=local_developer
